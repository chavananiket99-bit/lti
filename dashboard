function MoneyIcon() {
  return (
    <svg viewBox="0 0 24 24" className="dashboard-icon">
      <rect
        x="3"
        y="6"
        width="18"
        height="12"
        rx="2"
        fill="none"
        stroke="currentColor"
        strokeWidth="1.8"
      />
      <circle
        cx="12"
        cy="12"
        r="2.5"
        fill="none"
