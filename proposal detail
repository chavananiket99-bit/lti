import { RequestViewContent } from "../components/RequestViewModal.jsx";

const money = (n) => Number(n || 0).toLocaleString("en-IN");

const formatRate = (value, fallback = "-") => {
  if (value === null || value === undefined || value === "") return fallback;
  const parsed = Number(value);
  if (Number.isNaN(parsed)) return fallback;
  return parsed.toFixed(2);
};
const formatDate = (iso) => {
  if (!iso) return "";
  const d = new Date(iso);
  if (Number.isNaN(d.getTime())) return "";
  const dd = String(d.getDate()).padStart(2, "0");
  const mm = String(d.getMonth() + 1).padStart(2, "0");
  const yyyy = d.getFullYear();
  return `${dd}/${mm}/${yyyy}`;
};

const formatState = (state = "") =>
  state
    .replaceAll("_", " ")
    .toLowerCase()
    .replace(/\b\w/g, (c) => c.toUpperCase());

function AccordionSection({
  id,
  title,
  subtitle,
  icon,
  badge,
  isOpen,
  onToggle,
  children,
}) {
  return (
    <div className={`p-accordion-card ${isOpen ? "open" : "collapsed"}`}>
      <button
        type="button"
        className="p-accordion-header"
        onClick={() => onToggle(id)}
        aria-expanded={isOpen}
      >
        <div className="p-accordion-title-group">
          {icon && <span className="p-accordion-icon">{icon}</span>}
          <div className="p-accordion-text-stack">
            <span className="p-accordion-title">{title}</span>
            {subtitle && <span className="p-accordion-subtitle">{subtitle}</span>}
          </div>
          {badge && <span className="p-accordion-badge">{badge}</span>}
        </div>

        <div className="p-accordion-right">
          <span className={`p-chevron ${isOpen ? "rotate" : ""}`}>
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.4" strokeLinecap="round" strokeLinejoin="round">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </span>
        </div>
      </button>

      {isOpen && (
        <div className="p-accordion-content">
          {children}
        </div>
      )}
    </div>
  );
}

function DisbursementList({ proposal }) {
  const rows = proposal.disbursements || [];

  if (rows.length === 0) {
    return (
      <div style={{ padding: "0.6rem", textAlign: "center", color: "#94a3b8", fontSize: "0.8rem" }}>
        No disbursements recorded yet.
      </div>
    );
  }

  return (
    <div>
      <div className="table-wrapper">
        <table className="table" style={{ width: "100%", borderCollapse: "collapse", fontSize: "0.9rem" }}>
          <thead>
            <tr style={{ background: "#f8fafc", textAlign: "left" }}>
              <th style={{ padding: "6px 10px" }}>Amount</th>
              <th style={{ padding: "6px 10px" }}>Currency</th>
              <th style={{ padding: "6px 10px" }}>Exchange Rate</th>
              <th style={{ padding: "6px 10px" }}>Disbursement Date</th>
              <th style={{ padding: "6px 10px" }}>Payment Reference</th>
              <th style={{ padding: "6px 10px" }}>Recorded By</th>
            </tr>
          </thead>
          <tbody>
            {rows.map((d) => (
              <tr key={d.id} style={{ borderBottom: "1px solid #f1f5f9" }}>
                <td style={{ padding: "6px 10px", fontWeight: 600 }}>{money(d.amount)}</td>
                <td style={{ padding: "6px 10px" }}>{d.currency_code}</td>
                <td style={{ padding: "6px 10px" }}>{formatRate(d.exchange_rate)}</td>
                <td style={{ padding: "6px 10px" }}>{d.value_date}</td>
                <td style={{ padding: "6px 10px" }}>{d.payment_reference}</td>
                <td style={{ padding: "6px 10px", color: "#64748b" }}>{d.created_by_name || d.created_by || "-"}</td>
