import { useCallback, useEffect, useState } from "react";
import { useParams } from "react-router-dom";
import {
  complianceApi,
  proposalsApi,
  questionnaireApi,
  usersApi,
  workflowApi,
} from "../services/endpoints";
import { useAuth } from "../hooks/useAuth.jsx";
import { Card, StateBadge, ErrorText, Field } from "../components/ui.jsx";

const money = (n) => Number(n || 0).toLocaleString("en-IN");

export default function ProposalDetail() {
  const { id } = useParams();
  const { isAdmin, hasRole } = useAuth();
  const [proposal, setProposal] = useState(null);
  const [actions, setActions] = useState([]);
  const [history, setHistory] = useState([]);
  const [error, setError] = useState(null);

  const load = useCallback(() => {
    setError(null);
    proposalsApi.get(id).then((r) => setProposal(r.data)).catch(setError);
    proposalsApi.availableActions(id).then((r) => setActions(r.data.actions)).catch(() => {});
    workflowApi.approvals(id).then((r) => setHistory(r.data.results || r.data)).catch(() => {});
  }, [id]);

  useEffect(() => load(), [load]);

  if (error) return <ErrorText error={error} />;
  if (!proposal) return <div>Loading proposal...</div>;

  return (
    <div>
      <div className="page-head">
        <h2>{proposal.reference_no}</h2>
        <StateBadge state={proposal.current_state} label={proposal.state_display} />
      </div>

      <div className="grid-2">
        <Card title="Proposal Details">
          <dl className="detail-list">
            <div><dt>Company</dt><dd>{proposal.company_name}</dd></div>
            <div><dt>Type</dt><dd>{proposal.investment_type_name}</dd></div>
            <div><dt>Counterparty</dt><dd>{proposal.counterparty}</dd></div>
            <div><dt>Amount</dt><dd>{proposal.currency_code} {money(proposal.amount)}</dd></div>
            <div><dt>Limit Type</dt><dd>{proposal.limit_type_display}</dd></div>
            <div><dt>Financial Year</dt><dd>{proposal.financial_year_code}</dd></div>
            <div><dt>Tenure</dt><dd>{proposal.tenure_months || "-"} months</dd></div>
            <div><dt>Interest</dt><dd>{proposal.interest_rate || "-"}%</dd></div>
            <div><dt>Material</dt><dd>{proposal.is_material ? "Yes" : "No"}</dd></div>
            <div><dt>Total Disbursed</dt><dd>{money(proposal.total_disbursed)}</dd></div>
          </dl>
          <p className="muted">{proposal.purpose}</p>
        </Card>

        <WorkflowPanel
          proposal={proposal}
          actions={actions}
          onDone={load}
        />
      </div>

      <Questionnaire proposalId={id} state={proposal.current_state} onSaved={load} />

      <ComplianceChecklist proposalId={id} />

      <Documents proposal={proposal} onUploaded={load} />

      {(hasRole("CASH_MANAGEMENT", "HO_ACCOUNTS") || isAdmin()) && (
        <DisbursementPanel proposal={proposal} onDone={load} />
      )}

      <Card title="Approval History">
        <table className="table">
          <thead>
            <tr><th>When</th><th>Actor</th><th>Action</th><th>From → To</th><th>Remarks</th></tr>
          </thead>
          <tbody>
            {history.map((h) => (
              <tr key={h.id}>
                <td>{new Date(h.created_at).toLocaleString()}</td>
                <td>{h.actor_name} <span className="muted">({h.actor_role})</span></td>
                <td>{h.action_display}</td>
                <td>{h.from_state} → {h.to_state}</td>
                <td>{h.remarks}</td>
              </tr>
            ))}
            {history.length === 0 && (
              <tr><td colSpan={5} className="muted center">No actions yet.</td></tr>
            )}
          </tbody>
        </table>
      </Card>
    </div>
  );
}

function WorkflowPanel({ proposal, actions, onDone }) {
  const [remarks, setRemarks] = useState("");
  const [assignee, setAssignee] = useState("");
  const [execs, setExecs] = useState([]);
  const [error, setError] = useState(null);
  const [busy, setBusy] = useState(false);

  const needsAssignee = proposal.current_state === "CORP_FINANCE_HEAD_REVIEW";

  useEffect(() => {
    if (needsAssignee) {
      usersApi.approvers()
        .then((r) => {
          const list = r.data.results || r.data;
          console.log(JSON.stringify(list));
          setExecs(list);
        })
        .catch(() => {});
    }
  }, [needsAssignee]);

  const actionLabel = {
    SUBMIT: "Submit",
    APPROVE: "Approve / Forward",
    REJECT: "Reject / Send Back",
    COMPLETE: "Complete Disbursement",
  };

  async function run(action) {
    setBusy(true);
    setError(null);
    try {
      const payload = { remarks };
      if (needsAssignee && action === "APPROVE") payload.assignee = assignee;
      const endpoint = action.toLowerCase();
      await proposalsApi.act(proposal.id, endpoint, payload);
      setRemarks("");
      onDone();
    } catch (err) {
      setError(err);
    } finally {
      setBusy(false);
    }
  }

  if (actions.length === 0) {
    return (
      <Card title="Workflow">
        <p className="muted">You have no pending actions on this proposal at its current stage.</p>
      </Card>
    );
  }

  return (
    <Card title="Workflow Actions">
      {needsAssignee && (
        <Field label="Select Authorised Person (Group MD & CEO / Group CFO / Other)">
          <select value={assignee} onChange={(e) => setAssignee(e.target.value)}>
            <option value="">Select approver</option>
            {execs.map((u) => (
              <option key={u.id} value={u.id}>{u.full_name} ({u.role_code})</option>
            ))}
          </select>
        </Field>
      )}
      <Field label="Remarks (mandatory for reject)">
        <textarea value={remarks} onChange={(e) => setRemarks(e.target.value)} rows={2} />
      </Field>
      <ErrorText error={error} />
      <div className="btn-row">
        {actions.map((a) => (
          <button
            key={a}
            className={`btn ${a === "REJECT" ? "btn-danger" : "btn-primary"}`}
            disabled={busy}
            onClick={() => run(a)}
          >
            {actionLabel[a] || a}
          </button>
        ))}
      </div>
    </Card>
  );
}

function Questionnaire({ proposalId, state, onSaved }) {
  const [questions, setQuestions] = useState([]);
  const [answers, setAnswers] = useState({});
  const [error, setError] = useState(null);
  const [msg, setMsg] = useState("");

  const load = useCallback(() => {
    questionnaireApi.forProposal(proposalId).then((r) => {
      setQuestions(r.data.questions);
      const map = {};
      r.data.questions.forEach((q) => (map[q.id] = q.answer_text || ""));
      setAnswers(map);
    });
  }, [proposalId]);

  useEffect(() => load(), [load, state]);

  if (questions.length === 0) return null;

  async function save() {
    setError(null);
    try {
      await questionnaireApi.bulkAnswer({
        proposal: proposalId,
        answers: Object.entries(answers).map(([question, answer_text]) => ({
          question: Number(question),
          answer_text,
        })),
      });
      setMsg("Questionnaire saved.");
      setTimeout(() => setMsg(""), 2500);
      onSaved();
    } catch (err) {
      setError(err);
    }
  }

  return (
    <Card title="Questionnaire (your role, this stage)">
      {questions.map((q) => (
        <Field key={q.id} label={`${q.text}${q.is_mandatory ? " *" : ""}`}>
          {q.answer_type === "BOOLEAN" ? (
            <select
              value={answers[q.id] || ""}
              onChange={(e) => setAnswers({ ...answers, [q.id]: e.target.value })}
            >
              <option value="">Select</option>
              <option value="Yes">Yes</option>
              <option value="No">No</option>
            </select>
          ) : q.answer_type === "CHOICE" ? (
            <select
              value={answers[q.id] || ""}
              onChange={(e) => setAnswers({ ...answers, [q.id]: e.target.value })}
            >
              <option value="">Select</option>
              {(q.options || []).map((o) => (
                <option key={o} value={o}>{o}</option>
              ))}
            </select>
          ) : (
            <input
              type={q.answer_type === "NUMBER" ? "number" : "text"}
              value={answers[q.id] || ""}
              onChange={(e) => setAnswers({ ...answers, [q.id]: e.target.value })}
            />
          )}
        </Field>
      ))}
      <ErrorText error={error} />
      {msg && <div className="success-text">{msg}</div>}
      <button className="btn btn-primary" onClick={save}>Save Answers</button>
    </Card>
  );
}

function ComplianceChecklist({ proposalId }) {
  const [items, setItems] = useState([]);
  const [error, setError] = useState(null);

  const load = useCallback(() => {
    complianceApi.forProposal(proposalId).then((r) => setItems(r.data.items)).catch(setError);
  }, [proposalId]);

  useEffect(() => load(), [load]);

  if (items.length === 0) return null;

  async function confirm(item, confirmed, remarks, file) {
    const fd = new FormData();
    fd.append("proposal", proposalId);
    fd.append("item", item.id);
    fd.append("is_confirmed", confirmed);
    fd.append("remarks", remarks || "");
    if (file) fd.append("document", file);
    try {
      await complianceApi.saveValidation(fd, item.validation?.id);
      load();
    } catch (err) {
      setError(err);
    }
  }

  return (
    <Card title="Compliance Checklist (Sec 16.1)">
      <ErrorText error={error} />
      <table className="table">
        <thead>
          <tr><th>Item</th><th>Responsible</th><th>Status</th><th>Confirm</th></tr>
        </thead>
        <tbody>
          {items.map((it) => (
            <ComplianceRow key={it.id} item={it} onConfirm={confirm} />
          ))}
        </tbody>
      </table>
    </Card>
  );
}

function ComplianceRow({ item, onConfirm }) {
  const [remarks, setRemarks] = useState(item.validation?.remarks || "");
  const [file, setFile] = useState(null);
  const confirmed = item.validation?.is_confirmed;
  return (
    <tr>
      <td>
        <strong>{item.title}</strong>
        <div className="muted small">{item.category_display}</div>
      </td>
      <td>{item.responsible_display}</td>
      <td>
        {confirmed ? (
          <span className="badge badge-success">Confirmed</span>
        ) : (
          <span className="badge badge-muted">Pending</span>
        )}
      </td>
      <td>
        <input
          className="inline-input"
          placeholder="Remarks"
          value={remarks}
          onChange={(e) => setRemarks(e.target.value)}
        />
        {item.requires_document && (
          <input type="file" onChange={(e) => setFile(e.target.files[0])} />
        )}
        <button
          className="btn btn-light btn-sm"
          onClick={() => onConfirm(item, !confirmed, remarks, file)}
        >
          {confirmed ? "Unconfirm" : "Confirm"}
        </button>
      </td>
    </tr>
  );
}

function Documents({ proposal, onUploaded }) {
  const [file, setFile] = useState(null);
  const [docType, setDocType] = useState("");
  const [error, setError] = useState(null);

  async function upload() {
    if (!file) return;
    const fd = new FormData();
    fd.append("proposal", proposal.id);
    fd.append("file", file);
    fd.append("doc_type", docType);
    try {
      await proposalsApi.uploadDocument(fd);
      setFile(null);
      setDocType("");
      onUploaded();
    } catch (err) {
      setError(err);
    }
  }

  return (
    <Card title="Documents">
      <div className="btn-row">
        <input type="file" onChange={(e) => setFile(e.target.files[0])} />
        <input placeholder="Document type" value={docType} onChange={(e) => setDocType(e.target.value)} />
        <button className="btn btn-primary btn-sm" onClick={upload}>Upload</button>
      </div>
      <ErrorText error={error} />
      <ul className="doc-list">
        {(proposal.documents || []).map((d) => (
          <li key={d.id}>
            <a href={d.file} target="_blank" rel="noreferrer">{d.doc_type || "Document"}</a>
            <span className="muted small"> — {d.uploaded_by_name}</span>
          </li>
        ))}
        {(proposal.documents || []).length === 0 && <li className="muted">No documents.</li>}
      </ul>
    </Card>
  );
}

function DisbursementPanel({ proposal, onDone }) {
  const [form, setForm] = useState({
    amount: "", value_date: "", exchange_rate: "1", payment_reference: "", remarks: "",
  });
  const [error, setError] = useState(null);
  const set = (k) => (e) => setForm({ ...form, [k]: e.target.value });

  async function submit() {
    setError(null);
    try {
      await proposalsApi.disburse(proposal.id, { ...form, currency: proposal.currency });
      setForm({ amount: "", value_date: "", exchange_rate: "1", payment_reference: "", remarks: "" });
      onDone();
    } catch (err) {
      setError(err);
    }
  }

  return (
    <Card title="Record Disbursement">
      <div className="form-grid">
        <Field label="Amount"><input type="number" step="0.01" value={form.amount} onChange={set("amount")} /></Field>
        <Field label="Value Date"><input type="date" value={form.value_date} onChange={set("value_date")} /></Field>
        <Field label="Exchange Rate"><input type="number" step="0.000001" value={form.exchange_rate} onChange={set("exchange_rate")} /></Field>
        <Field label="Payment Reference"><input value={form.payment_reference} onChange={set("payment_reference")} /></Field>
      </div>
      <ErrorText error={error} />
      <button className="btn btn-primary" onClick={submit}>Record Disbursement</button>

      <table className="table" style={{ marginTop: 16 }}>
        <thead>
          <tr><th>Amount</th><th>Currency</th><th>Value Date</th><th>Reference</th></tr>
        </thead>
        <tbody>
          {(proposal.disbursements || []).map((d) => (
            <tr key={d.id}>
              <td>{money(d.amount)}</td>
              <td>{d.currency_code}</td>
              <td>{d.value_date}</td>
              <td>{d.payment_reference}</td>
            </tr>
          ))}
          {(proposal.disbursements || []).length === 0 && (
            <tr><td colSpan={4} className="muted center">No disbursements yet.</td></tr>
          )}
        </tbody>
      </table>
    </Card>
  );
}
