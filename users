import { useEffect, useState } from "react";
import { usersApi, mastersApi } from "../services/endpoints";
import { Card, ErrorText, Field } from "../components/ui.jsx";

export default function Users() {
  const [users, setUsers] = useState([]);
  const [roles, setRoles] = useState([]);
  const [companies, setCompanies] = useState([]);
  const [error, setError] = useState(null);
  const [editing, setEditing] = useState(null);

  function load() {
    usersApi.list().then((r) => setUsers(r.data.results || r.data)).catch(setError);
  }

  useEffect(() => {
    load();
    usersApi.roles().then((r) => setRoles(r.data.results || r.data));
    mastersApi.companies().then((r) => setCompanies(r.data.results || r.data));
  }, []);

  return (
    <div>
      <div className="page-head">
        <h2>Users &amp; Roles</h2>
        <button className="btn btn-success" onClick={() => setEditing({})}>+ Add User</button>
      </div>
      <ErrorText error={error} />
      <table className="table">
        <thead>
          <tr><th>Username</th><th>Name</th><th>Email</th><th>Role</th><th>Company</th><th>Active</th><th></th></tr>
        </thead>
        <tbody>
          {users.map((u) => (
            <tr key={u.id}>
              <td>{u.username}</td>
              <td>{u.full_name}</td>
              <td>{u.email}</td>
              <td>{u.role_name}</td>
              <td>{u.company_name || "-"}</td>
              <td>{u.is_active ? "Yes" : "No"}</td>
              <td><button className="btn btn-light btn-sm" onClick={() => setEditing(u)}>Edit</button></td>
            </tr>
          ))}
        </tbody>
      </table>

      {editing && (
        <UserForm
          user={editing}
          roles={roles}
          companies={companies}
          onClose={() => setEditing(null)}
          onSaved={() => {
            setEditing(null);
            load();
          }}
        />
      )}
    </div>
  );
}

function UserForm({ user, roles, companies, onClose, onSaved }) {
  const isNew = !user.id;
  const [form, setForm] = useState({
    username: user.username || "",
    email: user.email || "",
    first_name: user.first_name || "",
    last_name: user.last_name || "",
    role: user.role || "",
    company: user.company || "",
    is_active: user.is_active ?? true,
    password: "",
  });
  const [error, setError] = useState(null);
  const set = (k) => (e) => setForm({ ...form, [k]: e.target.value });

  async function save() {
    setError(null);
    try {
      const payload = { ...form };
      if (!payload.company) delete payload.company;
      if (!isNew && !payload.password) delete payload.password;
      if (isNew) await usersApi.create(payload);
      else await usersApi.update(user.id, payload);
      onSaved();
    } catch (err) {
      setError(err);
    }
  }

  return (
    <div className="modal-backdrop" onClick={onClose}>
      <div className="modal" onClick={(e) => e.stopPropagation()}>
        <Card title={isNew ? "Add User" : "Edit User"}>
          <div className="form-grid">
            <Field label="Username"><input value={form.username} onChange={set("username")} disabled={!isNew} /></Field>
            <Field label="Email"><input value={form.email} onChange={set("email")} /></Field>
            <Field label="First Name"><input value={form.first_name} onChange={set("first_name")} /></Field>
            <Field label="Last Name"><input value={form.last_name} onChange={set("last_name")} /></Field>
            <Field label="Role">
              <select value={form.role} onChange={set("role")}>
                <option value="">Select role</option>
                {roles.map((r) => <option key={r.id} value={r.id}>{r.name}</option>)}
              </select>
            </Field>
            <Field label="Company (optional)">
              <select value={form.company} onChange={set("company")}>
                <option value="">None</option>
                {companies.map((c) => <option key={c.id} value={c.id}>{c.name}</option>)}
              </select>
            </Field>
            <Field label={isNew ? "Password" : "New Password (optional)"}>
              <input type="password" value={form.password} onChange={set("password")} />
            </Field>
          </div>
          <ErrorText error={error} />
          <div className="btn-row">
            <button className="btn btn-primary" onClick={save}>Save</button>
            <button className="btn btn-light" onClick={onClose}>Cancel</button>
          </div>
        </Card>
      </div>
    </div>
  );
}
