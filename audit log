import { useEffect, useState } from "react";
import { auditApi } from "../services/endpoints";
import { ErrorText } from "../components/ui.jsx";

export default function AuditLog() {
  const [logs, setLogs] = useState([]);
  const [error, setError] = useState(null);
  const [action, setAction] = useState("");

  useEffect(() => {
    auditApi
      .list(action ? { action } : {})
      .then((r) => setLogs(r.data.results || r.data))
      .catch(setError);
  }, [action]);

  return (
    <div>
      <h2>Audit Trail</h2>
      <select className="search" value={action} onChange={(e) => setAction(e.target.value)}>
        <option value="">All actions</option>
        {["LOGIN", "CREATE", "UPDATE", "SUBMIT", "APPROVE", "REJECT", "DISBURSE", "UPLOAD", "EXPORT"].map((a) => (
          <option key={a} value={a}>{a}</option>
        ))}
      </select>
      <ErrorText error={error} />
      <table className="table">
        <thead>
          <tr><th>When</th><th>User</th><th>Action</th><th>Entity</th><th>Description</th><th>IP</th></tr>
        </thead>
        <tbody>
          {logs.map((l) => (
            <tr key={l.id}>
              <td>{new Date(l.created_at).toLocaleString()}</td>
              <td>{l.user_name || l.username || "-"}</td>
              <td>{l.action}</td>
              <td>{l.entity_type} {l.entity_id && `#${l.entity_id}`}</td>
              <td>{l.description}</td>
              <td>{l.ip_address}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  );
}
